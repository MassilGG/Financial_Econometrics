   "source": [
    "from scipy.stats import norm\n",
    "\n",
    "# Non Parametric VaR\n",
    "var_5 = sampled_data['logret'].quantile(0.05)\n",
    "print('Non Parametric VaR : ',var_5)\n",
    "\n",
    "# Parametric VaR\n",
    "RV = (sampled_data['logret']**2).sum()\n",
    "var_norm_5 = RV * norm.ppf(0.05)\n",
    "print('Parametric Normal VaR : ',var_norm_5)"
