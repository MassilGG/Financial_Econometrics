    "from scipy import stats\n",
    "from statsmodels.stats.diagnostic import acorr_ljungbox\n",
    "from statsmodels.stats.stattools import jarque_bera\n",
    "\n",
    "\"\"\"\n",
    "X: log-midquote series indexed by timestamps (must be equally spaced or resampled)\n",
    "h: horizon for VaR, e.g. '5min'\n",
    "\"\"\"\n",
    "# horizon returns\n",
    "r_h = X.diff(pd.Timedelta(h)).dropna()\n",
    "\n",
    "# daily realized variance from base-grid returns (use your chosen sampling)\n",
    "r_base = X.diff().dropna()\n",
    "RV_d = float((r_base**2).sum())\n",
    "\n",
    "# session length in seconds\n",
    "T = (X.index[-1] - X.index[0]).total_seconds()\n",
    "h_sec = pd.Timedelta(h).total_seconds()\n",
    "\n",
    "# scale daily RV to horizon variance\n",
    "sigma_h = np.sqrt((h_sec / T) * RV_d)\n",
    "\n",
    "z = stats.norm.ppf(alpha)\n",
    "VaR_h = -z * sigma_h  # positive number as loss threshold\n",
    "\n",
    "# tests on standardized intraday returns\n",
    "U = (r_h / sigma_h).dropna()\n",
    "\n",
    "jb_stat, jb_p, skew, kurt_excess = jarque_bera(U)\n",
    "lb_p = acorr_ljungbox(U, lags=[10], return_df=True)[\"lb_pvalue\"].iloc[0]\n",
    "lb2_p = acorr_ljungbox(U**2, lags=[10], return_df=True)[\"lb_pvalue\"].iloc[0]\n",
    "\n"
