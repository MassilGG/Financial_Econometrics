    "def rolling_autocov(x, window=200):\n",
    "    \"\"\"\n",
    "    Rolling lag-1 autocovariance of series x.\n",
    "    \"\"\"\n",
    "    x = pd.Series(x).dropna()\n",
    "    mean = x.rolling(window).mean()\n",
    "\n",
    "    cov = ((x.shift(0) - mean) * (x.shift(1) - mean)).rolling(window).mean()\n",
    "    return cov"
   ]
