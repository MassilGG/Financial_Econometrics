    "def get_RV(data,T):\n",
    "    '''\n",
    "    Compute Realized variance depending on sampling frequency\n",
    "        data (pd.DataFrame) - price data\n",
    "        T (int) - sampling period in second\n",
    "    '''\n",
    "    resampled_prices = resample(data,T)\n",
    "    logret = np.log(resampled_prices).diff()\n",
    "    RV = (logret**2).sum()\n",
    "    return RV*100\n",
    "\n",
